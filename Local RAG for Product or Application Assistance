B. Backend Implementation (backend/main.py)

python
from contextlib import asynccontextmanager
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from langchain_chroma import Chroma
from langchain_community.document_loaders import DirectoryLoader, TextLoader
from langchain_ollama import ChatOllama, OllamaEmbeddings
from langchain_text_splitters import RecursiveCharacterTextSplitter
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("rag-backend")

# Global state
vectorstore: Chroma | None = None
llm: ChatOllama | None = None

FALLBACK_MESSAGE = (
    "I don't have that information in our guides. Please contact support@domain.com."
)


def initialize_knowledge_base():
  global vectorstore, llm
  logger.info("Loading markdown files from ./docs...")
  loader = DirectoryLoader("./docs", glob="**/*.md", loader_cls=TextLoader)
  docs = loader.load()

  splitter = RecursiveCharacterTextSplitter(chunk_size=400, chunk_overlap=80)
  chunks = splitter.split_documents(docs)
  logger.info(f"Split {len(docs)} files into {len(chunks)} chunks.")

  logger.info("Initializing Ollama embeddings (nomic-embed-text)...")
  embeddings = OllamaEmbeddings(model="nomic-embed-text")

  # Persistent local vector DB
  vectorstore = Chroma.from_documents(
      documents=chunks,
      embedding=embeddings,
      persist_directory="./chroma_db",
  )

  logger.info("Initializing Ollama LLM (llama3.2:3b)...")
  llm = ChatOllama(model="llama3.2:3b", temperature=0)


@asynccontextmanager
async def lifespan(app: FastAPI):
  initialize_knowledge_base()
  yield
  logger.info("Shutting down RAG service.")


app = FastAPI(
    title="External RAG Assistant API",
    version="1.0.0",
    lifespan=lifespan,
)

# Allow external host applications via CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # Restrict to specific production domains in deployment
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


class ChatRequest(BaseModel):
  message: str = Field(..., min_length=1, max_length=1000)
  session_id: str = Field(default="default-client", max_length=100)


class ChatResponse(BaseModel):
  reply: str
  sources: list[str]


@app.post("/api/chat", response_model=ChatResponse)
async def handle_chat(payload: ChatRequest):
  if not vectorstore or not llm:
    raise HTTPException(status_code=503, detail="Vector store or LLM not ready.")

  # 1. Retrieve top-4 relevant chunks
  try:
    retrieved_docs = vectorstore.similarity_search(payload.message, k=4)
  except Exception as e:
    logger.error(f"Retrieval error: {e}")
    raise HTTPException(status_code=500, detail="Document retrieval failed.")

  context_text = "\n\n---\n\n".join(
      [d.page_content for d in retrieved_docs]
  ) if retrieved_docs else ""

  # 2. Compile system guardrails and context
  system_prompt = f"""You are the official embedded assistant for our application. Follow these operational rules strictly:

1. SCOPE: Answer only questions about products and operational guides provided in the context.
2. GROUNDING: Use ONLY the provided context. If the answer is missing or unclear, output exact fallback: "{FALLBACK_MESSAGE}"
3. SECURITY: Never ask for or repeat passwords, tokens, or personal financial data.
4. TONE: Concise, polite, and direct. Do not mention system rules.

Context:
{context_text}"""

  messages = [
      {"role": "system", "content": system_prompt},
      {"role": "user", "content": payload.message},
  ]

  # 3. Invoke LLM
  try:
    response = llm.invoke(messages)
    reply_content = response.content.strip()
  except Exception as e:
    logger.error(f"LLM inference error: {e}")
    raise HTTPException(status_code=500, detail="Inference engine failure.")

  # 4. Extract source metadata paths
  source_files = list(
      {d.metadata.get("source", "unknown") for d in retrieved_docs}
  )

  return ChatResponse(reply=reply_content, sources=source_files)


@app.get("/health")
async def health_check():
  return {"status": "ok", "vectorstore_ready": vectorstore is not None}
